---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate } = Astro.props;
---

<style>
	.tech-tags-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 1rem;
	}

	.blog-meta {
		display: flex;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
		margin-top: 0.5rem;
	}
</style>

<BaseLayout title={title} description={description}>
	<article class="prose stagger project-detail-article">
		<a href="/blog" class="back-link">
			← Volver al blog
		</a>

		<header class="project-header">
			<h1 class="project-detail-title">{title}</h1>
			<div class="blog-meta">
				<time datetime={pubDate.toISOString()} class="date-badge">
					{pubDate.toLocaleDateString('es-ES', {
						year: 'numeric',
						month: 'long',
						day: 'numeric',
					})}
				</time>
				{updatedDate && (
					<span class="date-badge" style="font-style: italic;">
						· Actualizado: {updatedDate.toLocaleDateString('es-ES', {
							year: 'numeric',
							month: 'short',
							day: 'numeric',
						})}
					</span>
				)}
			</div>
		</header>

		<slot />
	</article>
</BaseLayout>
