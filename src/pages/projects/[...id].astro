---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageGallery from '../../components/ImageGallery.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects
		.filter(project => !project.data.isExternal)
		.map(project => ({
			params: { id: project.id },
			props: { project },
		}));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={`${project.data.title} - Proyecto | Felipe Reynoso`} description={project.data.description}>
	<article class="prose" style="max-width: 800px; margin: 0 auto;">
		<a href="/#projects" style="font-size: 0.9rem; color: var(--text-muted);">← Volver al inicio</a>
		
		<header style="margin-top: 2rem; margin-bottom: 2rem;">
			<h1 style="color: var(--text-main); font-size: 2.5rem; margin-bottom: 1rem;">{project.data.title}</h1>
			<p style="font-size: 1.2rem; color: var(--text-muted);">{project.data.description}</p>
			<div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem;">
				{project.data.tags.map((tag: string) => (
					<span class="tag">{tag}</span>
				))}
			</div>
		</header>

		{project.data.images && project.data.images.length > 0 && (
			<ImageGallery images={project.data.images} />
		)}

		<section style="margin-top: 2rem;">
			<Content />

			{project.data.githubLink && (
				<div style="margin-top: 4rem; margin-bottom: 4rem; text-align: center;">
					<a href={project.data.githubLink} target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; gap: 0.8rem; background-color: var(--text-main); color: var(--bg-color); padding: 0.8rem 2rem; border-radius: 8px; font-weight: 600; text-decoration: none; transition: transform 0.2s ease; box-shadow: 0 4px 12px rgba(240, 244, 248, 0.1);">
						<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
						Ver Repositorio en GitHub
					</a>
				</div>
			)}
		</section>
	</article>
</BaseLayout>
