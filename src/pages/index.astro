---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TerminalHero from '../components/TerminalHero.astro';

import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
).slice(0, 3);

const projects = (await getCollection('projects'))
	.filter((p) => !p.data.draft)
	.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Felipe Reynoso — Backend Developer & Odoo">

	<!-- ════════════════════════════ HERO / ABOUT ════════════════════════════ -->
	<section id="about" class="about-section" style="padding: 4rem 0 8rem 0;">
		<div class="hero-inner stagger">
			<div class="hero-grid-container">
				<div class="hero-text-block">
					<span class="section-label">Sistema // Portfolio</span>
					<h1 class="hero-title">
						<span class="accent">Architecture</span> & Backend
					</h1>
					<p class="hero-description-alt">
						Diseño soluciones escalables en <strong>Python</strong> y <strong>Odoo</strong>. 
						Especializado en la optimización de procesos de negocio complejos y arquitectura de datos.
					</p>
					
					<div class="hero-actions">
						<a href="mailto:felipereynoso171@gmail.com" class="btn btn-primary" id="hero-contact-btn">
							<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path d="M24 5.457v13.909c0 .904-.732 1.636-1.636 1.636h-3.819V11.73L12 16.64l-6.545-4.91v9.273H1.636A1.636 1.636 0 0 1 0 19.366V5.457c0-2.023 2.309-3.178 3.927-1.964L5.455 4.64 12 9.548l6.545-4.91 1.528-1.145C21.69 2.28 24 3.434 24 5.457z"/>
							</svg>
							Solicitar presupuesto
						</a>
						<a href="https://github.com/Felirey03" target="_blank" rel="noopener noreferrer" class="btn btn-secondary" id="hero-github-btn">
							GitHub
						</a>
					</div>
				</div>
				<div class="hero-visual-block">
					<TerminalHero />
				</div>
			</div>
		</div>
	</section>

	<!-- ════════════════════════════ PROJECTS ════════════════════════════ -->
	<section id="projects">
		<span class="section-label">Engineering</span>
		<h2 class="section-title">Soluciones de <span class="outline">Impacto Real</span></h2>
		<p class="section-description text-center">Software robusto diseñado para digitalizar operaciones y maximizar la eficiencia.</p>
		
		<div class="projects-grid stagger">
			{projects.map((project, index) => (
				<ProjectCard
					title={project.data.title}
					description={project.data.description}
					tags={project.data.tags}
					link={project.data.isExternal ? (project.data.link || project.data.githubLink || '#') : `/projects/${project.id}`}
					isExternal={project.data.isExternal}
					dataIndex={String(index + 1).padStart(2, '0')}
					isFeatured={index === 0}
				/>
			))}
		</div>
	</section>

	<!-- ════════════════════════════ BLOG ════════════════════════════ -->
	<section id="recent-posts">
		<span class="section-label">Escribiendo // Blog</span>
		<h2 class="section-title">Últimos <span class="outline">Artículos</span></h2>
		<p class="section-description">Notas sobre ingeniería de software, arquitectura de sistemas y el ecosistema de Odoo.</p>
		<div class="post-list stagger">
			{posts.length > 0 ? (
				posts.map((post) => (
					<div class="post-item">
						<span class="post-item-date">
							{post.data.pubDate.toLocaleDateString('es-ES', {
								year: 'numeric',
								month: 'short',
								day: 'numeric',
							})}
						</span>
						<div>
							<a href={`/blog/${post.id}/`} class="post-item-title">
								{post.data.title}
							</a>
							{post.data.description && (
								<p class="post-item-desc">{post.data.description}</p>
							)}
						</div>
					</div>
				))
			) : (
				<p style="color: var(--text-muted); font-size: 0.9rem; padding: 1rem 0;">Aún no hay posts publicados.</p>
			)}
		</div>
		{posts.length > 0 && (
			<a href="/blog" class="view-all-link">
				Ver todos los artículos
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<line x1="5" y1="12" x2="19" y2="12"/>
					<polyline points="12 5 19 12 12 19"/>
				</svg>
			</a>
		)}
	</section>

</BaseLayout>
